  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@playwright/test": "1.51.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
